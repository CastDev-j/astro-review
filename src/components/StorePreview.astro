---
import { FaHouseUser  } from "react-icons/fa";

import { Counters } from "./Counters";
import { CounterInfo } from "./CounterInfo";

import { LoginLogout } from "@/components/LoginLogout";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);
---

<div class="max-w-md mx-auto animate-fade animate-once animate-duration-100">
  <LoginLogout session={session} client:load />

  {
    session ? (
      <>
        <CounterInfo client:load />
        <Counters client:load />
      </>
    ) : (
      <div class="flex flex-col items-center justify-center p-6 text-center bg-gray-100 rounded-lg mt-6">
        <div class="text-4xl text-gray-400 mb-2">
          <FaHouseUser  className="text-5xl"/>
        </div>
        <h2 class="text-lg font-semibold text-gray-700 mb-2">
          Necesitas iniciar sesión
        </h2>
        <p class="text-gray-500 mb-4">
          Debes tener una sesión activa para visualizar los contadores.
        </p>
      </div>
    )
  }
</div>
